diff --git a/net/minecraft/server/level/ServerEntity.java b/net/minecraft/server/level/ServerEntity.java
--- a/net/minecraft/server/level/ServerEntity.java
+++ b/net/minecraft/server/level/ServerEntity.java
@@ -211,7 +211,11 @@ public class ServerEntity {
                         } else if (!org.dreeam.leaf.config.modules.opt.ReduceUselessPackets.filterClientboundSetEntityMotionPacket || // Canvas - filter ClientboundSetEntityMotionPacket
                             (this.entity instanceof net.minecraft.world.entity.item.ItemEntity && currentPosition.distanceToSqr(this.positionCodec.base) >= 7.62939453125E-6D) ||
                             this.entity instanceof net.minecraft.world.entity.projectile.EyeOfEnder ||
                             this.entity instanceof net.minecraft.world.entity.animal.squid.Squid ||
                             this.entity instanceof net.minecraft.world.entity.projectile.ShulkerBullet ||
                             this.entity instanceof net.minecraft.world.entity.projectile.FishingHook
                         ) { // Leaf - Multithreaded tracker - diff on change
-                            this.synchronizer.sendToTrackingPlayers(new ClientboundSetEntityMotionPacket(this.entity.getId(), this.lastSentMovement));
+                            // Leaf start - cache ClientboundSetEntityMotionPacket
+                            this.synchronizer.sendToTrackingPlayers(
+                                org.dreeam.leaf.config.modules.opt.ReduceUselessPackets.cacheMotionPacket
+                                    ? this.leaf$getOrBuildMotionPacket()
+                                    : new ClientboundSetEntityMotionPacket(this.entity.getId(), this.lastSentMovement));
+                            // Leaf end - cache ClientboundSetEntityMotionPacket
                         }
                     }
@@ -314,6 +318,21 @@ public class ServerEntity {
         return !shouldSendRotation
             && packet instanceof ClientboundMoveEntityPacket moveEntityPacket
             && moveEntityPacket.getPositionDelta() instanceof VecDelta.Linear delta
             && delta.xa() == 0 && delta.ya() == 0 && delta.za() == 0;
     }
     // Leaf end - Dont send useless entity packets

+    // Leaf start - cache ClientboundSetEntityMotionPacket
+    private net.minecraft.network.protocol.game.ClientboundSetEntityMotionPacket leaf$cachedMotionPacket;
+    private net.minecraft.world.phys.Vec3 leaf$cachedMotionPacketVec;
+
+    private net.minecraft.network.protocol.game.ClientboundSetEntityMotionPacket leaf$getOrBuildMotionPacket() {
+        // SparklyPaper (patch 0101) guarantees lastSentMovement is reassigned to a fresh Vec3 reference
+        // whenever the entity's delta movement changes — never mutated in place — so an identity check
+        // is sufficient to detect "the cached packet is still valid".
+        if (this.leaf$cachedMotionPacketVec != this.lastSentMovement) {
+            this.leaf$cachedMotionPacketVec = this.lastSentMovement;
+            this.leaf$cachedMotionPacket = new net.minecraft.network.protocol.game.ClientboundSetEntityMotionPacket(this.entity.getId(), this.lastSentMovement);
+        }
+        return this.leaf$cachedMotionPacket;
+    }
+    // Leaf end - cache ClientboundSetEntityMotionPacket
+
     private void handleMinecartPosRot(final NewMinecartBehavior newMinecartBehavior, final byte yRotn, final byte xRotn, final boolean shouldSendRotation) {
         this.sendDirtyEntityData();
         if (newMinecartBehavior.lerpSteps.isEmpty()) {
@@ -571,7 +590,11 @@ public class ServerEntity {
                                 (this.entity instanceof net.minecraft.world.entity.item.ItemEntity && currentPosition.distanceToSqr(this.positionCodec.base) >= 7.62939453125E-6D) ||
                                 this.entity instanceof net.minecraft.world.entity.projectile.EyeOfEnder ||
                                 this.entity instanceof net.minecraft.world.entity.animal.squid.Squid ||
                                 this.entity instanceof net.minecraft.world.entity.projectile.ShulkerBullet ||
                                 this.entity instanceof net.minecraft.world.entity.projectile.FishingHook
                             ) {
-                                ctx.sendToTrackingPlayers(tracker, new ClientboundSetEntityMotionPacket(this.entity.getId(), this.lastSentMovement));
+                                // Leaf start - cache ClientboundSetEntityMotionPacket
+                                ctx.sendToTrackingPlayers(tracker,
+                                    org.dreeam.leaf.config.modules.opt.ReduceUselessPackets.cacheMotionPacket
+                                        ? this.leaf$getOrBuildMotionPacket()
+                                        : new ClientboundSetEntityMotionPacket(this.entity.getId(), this.lastSentMovement));
+                                // Leaf end - cache ClientboundSetEntityMotionPacket
                             }
                         }
